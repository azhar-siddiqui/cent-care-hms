generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  SUPER_ADMIN
  ADMIN
  RECEPTIONIST
  DOCTOR
  NURSE

  @@map("staff_role")
}

enum Gender {
  MALE
  FEMALE
  OTHER

  @@map("gender")
}

enum PaymentMode {
  CASH
  UPI
  CARD

  @@map("payment_mode")
}

enum PaymentStatus {
  PENDING
  PAID

  @@map("payment_status")
}

enum WardType {
  DAY_CARE
  GENERAL
  ICU
  SEMI_ICU_DELUXE

  @@map("ward_type")
}

enum BedStatus {
  OCCUPIED
  VACANT
  CLEANING

  @@map("bed_status")
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED

  @@map("admission_status")
}

enum ServiceType {
  ECG
  PROCEDURE
  OXYGEN

  @@map("service_type")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  supabaseUserId String?   @unique @map("supabase_user_id") @db.Uuid
  email          String    @unique
  fullName       String    @map("full_name")
  role           StaffRole
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  invitationsSent AdminInvitation[] @relation("InvitedBy")
  doseLogs        IpdDoseLog[]
  progressNotes   IpdProgressNote[]
  expenses        DailyExpense[]
  serviceCharges  ServiceCharge[]

  @@map("users")
}

model AdminInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  email       String
  tokenHash   String           @unique @map("token_hash")
  status      InvitationStatus @default(PENDING)
  role        StaffRole        @default(ADMIN)
  invitedById String           @map("invited_by_id") @db.Uuid
  invitedBy   User             @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  expiresAt   DateTime         @map("expires_at")
  acceptedAt  DateTime?        @map("accepted_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([email, status])
  @@map("admin_invitations")
}

model Patient {
  id            String   @id @default(uuid()) @db.Uuid
  patientNumber String   @unique @map("patient_number")
  fullName      String   @map("full_name")
  phone         String
  gender        Gender
  age           Int
  address       String?
  createdAt     DateTime @default(now()) @map("created_at")

  opdVisits      OpdVisit[]
  admissions     IpdAdmission[]
  serviceCharges ServiceCharge[]
  assignedBeds   Bed[]

  @@index([phone])
  @@index([fullName])
  @@map("patients")
}

model OpdVisit {
  id                  String        @id @default(uuid()) @db.Uuid
  visitNumber         String        @unique @map("visit_number")
  patientId           String        @map("patient_id") @db.Uuid
  patient             Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  consultationFee     Decimal       @map("consultation_fee") @db.Decimal(12, 2)
  referringDoctorName String?       @map("referring_doctor_name")
  referringHospital   String?       @map("referring_hospital")
  referralFee         Decimal       @default(0) @map("referral_fee") @db.Decimal(12, 2)
  paymentMode         PaymentMode?  @map("payment_mode")
  paymentStatus       PaymentStatus @default(PENDING) @map("payment_status")
  createdAt           DateTime      @default(now()) @map("created_at")

  @@index([patientId])
  @@index([createdAt])
  @@map("opd_visits")
}

model Bed {
  id                String    @id @default(uuid()) @db.Uuid
  bedNumber         String    @map("bed_number")
  wardType          WardType  @map("ward_type")
  status            BedStatus @default(VACANT)
  assignedPatientId String?   @map("assigned_patient_id") @db.Uuid
  assignedPatient   Patient?  @relation(fields: [assignedPatientId], references: [id], onDelete: SetNull)
  updatedAt         DateTime  @updatedAt @map("updated_at")

  admissions IpdAdmission[]

  @@unique([wardType, bedNumber])
  @@index([status])
  @@map("beds")
}

model IpdAdmission {
  id            String          @id @default(uuid()) @db.Uuid
  patientId     String          @map("patient_id") @db.Uuid
  patient       Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  bedId         String          @map("bed_id") @db.Uuid
  bed           Bed             @relation(fields: [bedId], references: [id], onDelete: Restrict)
  admissionDate DateTime        @default(now()) @map("admission_date")
  dischargeDate DateTime?       @map("discharge_date")
  status        AdmissionStatus @default(ADMITTED)
  totalAmount   Decimal         @default(0) @map("total_amount") @db.Decimal(12, 2)

  doseLogs       IpdDoseLog[]
  progressNotes  IpdProgressNote[]
  serviceCharges ServiceCharge[]

  @@index([patientId])
  @@index([bedId])
  @@index([status])
  @@map("ipd_admissions")
}

model IpdDoseLog {
  id                 String       @id @default(uuid()) @db.Uuid
  ipdAdmissionId     String       @map("ipd_admission_id") @db.Uuid
  ipdAdmission       IpdAdmission @relation(fields: [ipdAdmissionId], references: [id], onDelete: Cascade)
  medicineName       String       @map("medicine_name")
  dosage             String
  administeredBy     String       @map("administered_by") @db.Uuid
  administrator      User         @relation(fields: [administeredBy], references: [id], onDelete: Restrict)
  administeredByName String       @map("administered_by_name")
  administeredAt     DateTime     @default(now()) @map("administered_at")

  @@index([ipdAdmissionId])
  @@map("ipd_dose_logs")
}

model IpdProgressNote {
  id             String       @id @default(uuid()) @db.Uuid
  ipdAdmissionId String       @map("ipd_admission_id") @db.Uuid
  ipdAdmission   IpdAdmission @relation(fields: [ipdAdmissionId], references: [id], onDelete: Cascade)
  note           String
  authorId       String       @map("author_id") @db.Uuid
  author         User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([ipdAdmissionId])
  @@map("ipd_progress_notes")
}

model ServiceCharge {
  id             String        @id @default(uuid()) @db.Uuid
  patientId      String        @map("patient_id") @db.Uuid
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  ipdAdmissionId String?       @map("ipd_admission_id") @db.Uuid
  ipdAdmission   IpdAdmission? @relation(fields: [ipdAdmissionId], references: [id], onDelete: SetNull)
  serviceType    ServiceType   @map("service_type")
  amount         Decimal       @db.Decimal(12, 2)
  quantity       Decimal?      @db.Decimal(12, 3)
  unit           String?
  notes          String?
  createdBy      String?       @map("created_by") @db.Uuid
  creator        User?         @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([patientId])
  @@index([serviceType])
  @@map("service_charges")
}

model InventoryItem {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  quantity     Int
  unit         String
  reorderLevel Int      @map("reorder_level")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("inventory_items")
}

model DailyExpense {
  id            String      @id @default(uuid()) @db.Uuid
  category      String
  amount        Decimal     @db.Decimal(12, 2)
  description   String?
  paymentMethod PaymentMode @map("payment_method")
  expenseDate   DateTime    @map("expense_date") @db.Date
  createdBy     String      @map("created_by") @db.Uuid
  creator       User        @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([expenseDate])
  @@index([category])
  @@map("daily_expenses")
}
